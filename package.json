{
  "name": "jet-prediction-market",
  "version": "0.1.0",
  "private": true,
  "description": "Short-duration (2-minute) BTC binary prediction market — local demo. One canonical YES order book + signed positions; RAMP_V1 oracle.",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --filter @jet/api --filter @jet/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
